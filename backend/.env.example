# ==========================================
# MAGARAJOTHI TRADERS - BACKEND CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <database_name> with your MongoDB Atlas Credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/magarajothi_traders?retryWrites=true&w=majority

# Optional CORS Allowed Frontend URL
FRONTEND_URL=http://localhost:5173
